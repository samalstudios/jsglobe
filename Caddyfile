www.jsglobe.com {
	redir https://jsglobe.com{uri} permanent
}

jsglobe.com {
	root * /srv/jsglobe
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(self), camera=(self), display-capture=(self)"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.googletagmanager.com https://esm.run https://cdn.jsdelivr.net https://unpkg.com blob:; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' blob: data: https://esm.run https://cdn.jsdelivr.net https://unpkg.com https://huggingface.co https://*.hf.co https://raw.githubusercontent.com https://cloudflare-dns.com https://dns.google https://speed.cloudflare.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://api.coingecko.com https://rdap.org https://*.rdap.org https://rdap.verisign.com https://rdap.iana.org https://*.arin.net https://*.ripe.net https://*.apnic.net https://*.lacnic.net https://*.afrinic.net https://*.nic.br https://rdap.nominet.uk https://rdap.markmonitor.com https://rdap.publicinterestregistry.org https://rdap.centralnic.com https://rdap.godaddy.com wss: ws://localhost:* ws://127.0.0.1:* http://localhost:* http://127.0.0.1:*; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		-Server
	}

	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@code path /js/* /css/*
	header @code Cache-Control "public, max-age=300, must-revalidate"

	@shell path / /index.html /de /de/ /es /es/ /zh /zh/ /manifest.webmanifest /sitemap.xml /robots.txt
	header @shell Cache-Control "no-cache"

	handle /de/* {
		try_files {path} {path}/ /de/index.html
		file_server
	}

	handle /es/* {
		try_files {path} {path}/ /es/index.html
		file_server
	}

	handle /zh/* {
		try_files {path} {path}/ /zh/index.html
		file_server
	}

	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}
